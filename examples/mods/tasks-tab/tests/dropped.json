              { "id": "g:dropped", "head": true }
            ] },
            { "kind": "text", "text": "… 1 done, 1 dropped (b shows them)" },
            { "kind": "keys", "keys": [{ "key": "b", "label": "done" }] }
          ] } } },
      { "method": "ui.view.set", "params": { "view": "tasks",
          "widget": { "kind": "stack", "children": [
            { "kind": "table", "rows": [
              { "id": "g:backlog", "head": true },
              { "id": "T5" },
              { "id": "g:done", "head": true },
              { "id": "T6" },
              { "id": "g:dropped", "head": true },
              { "id": "T7", "actions": [
