      "result": [
        { "id": "T5", "title": "Idea", "status": "open", "steps_done": 0, "steps_total": 0, "steps": [] },
        { "id": "T6", "title": "Old", "status": "done", "steps_done": 0, "steps_total": 0, "steps": [], "updated": "2026-09-01" },
        { "id": "T7", "title": "Never mind", "status": "dropped", "steps_done": 0, "steps_total": 1, "steps": [{ "text": "Try", "done": false }], "updated": "2026-10-30" }
      ] }
