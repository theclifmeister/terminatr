            { "kind": "text", "text": "3 done · 0 open" },
            { "kind": "text", "text": "best month 3 on March 2024" },
            { "kind": "text" },
            { "kind": "curve", "values": [3], "under": [ { "label": "done", "word": "per month" } ] },
            { "kind": "text" },
            { "kind": "keys", "keys": [ { "key": "h" } ] }
          ] } } }
    ]
  }
