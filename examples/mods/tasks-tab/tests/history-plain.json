    { "method": "history.get", "params": { "slug": "demo" },
      "result": { "done": 3, "open": 0, "dropped": 0, "days": [], "timed": 0,
        "curve": { "unit": "month", "span": "3 years", "range": "10 Mar 2024 – 6 Nov",
          "points": [
            { "from": "2024-03-01", "to": "2024-03-31", "label": "Mar 2024", "done": 3, "total": 3, "tip": "March 2024: 3 done, 3 in all" }
          ],
          "best": { "done": 3, "word": "best month", "when": "March 2024" } } } },
    { "method": "tasks.done", "params": { "slug": "demo", "options": { "groups": true } },
