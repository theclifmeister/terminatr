{
  "name": "a note's front matter shows as one line, and t shows the note template",
  "answers": [
    { "method": "memory.list", "params": { "slug": "demo" },
      "result": [{ "path": "memory/retries.md", "title": "Retries stay at 4", "bytes": 160, "touches": ["internal/ticker/pr.go"] }] },
    { "method": "memory.read", "params": { "slug": "demo", "path": "memory/retries.md" },
      "result": "+++\ntitle = \"Retries stay at 4\"\ntouches = [\"internal/ticker/pr.go\", \"repo:api\"]\nstanding = true\nsource = \"T481\"\n+++\n## Decided\nKeep 4.\n" }
  ],
  "events": [
    { "name": "view.opened", "project": "demo",
      "data": { "view": "memory", "slot": "project.tab", "project": "demo", "width": 70, "height": 20 } },
    { "name": "ui.key", "project": "demo",
      "data": { "view": "memory", "widget": "files", "row": "memory/retries.md", "key": "enter", "target": { "project": "demo" } } },
    { "name": "ui.key", "project": "demo",
      "data": { "view": "memory", "key": "enter", "target": { "project": "demo" } } },
    { "name": "ui.key", "project": "demo",
      "data": { "view": "memory", "widget": "files", "row": "memory/retries.md", "key": "t", "target": { "project": "demo" } } }
  ],
  "expect": {
    "calls": [
      { "method": "ui.view.set", "params": { "view": "memory" } },
      { "method": "memory.read", "params": { "slug": "demo", "path": "memory/retries.md" } },
      { "method": "ui.view.set",
        "params": { "view": "memory", "options": { "project": "demo" },
          "widget": { "kind": "stack", "children": [
            { "kind": "text", "lines": [[{ "text": "Retries stay at 4", "role": "accent" }, { "text": "  memory/retries.md", "role": "faint" }]] },
            { "kind": "text", "text": "touches internal/ticker/pr.go, repo:api · standing · from T481", "role": "faint" },
            { "kind": "text", "text": "Decided", "role": "head" },
            { "kind": "text", "text": "Keep 4." },
            { "kind": "keys", "keys": [{ "key": "enter", "label": "files" }, { "key": "n", "label": "next" }, { "key": "p", "label": "previous" }] }
          ] } } },
      { "method": "ui.view.set", "params": { "view": "memory" } },
      { "method": "ui.view.set",
        "params": { "view": "memory", "options": { "project": "demo" },
          "widget": { "kind": "stack", "children": [
            { "kind": "text", "lines": [[{ "text": "New note", "role": "accent" }, { "text": "  memory/<name>.md · tm memory template", "role": "faint" }]] },
            { "kind": "text" },
            { "kind": "text", "role": "faint" },
            { "kind": "keys", "keys": [{ "key": "enter", "label": "files" }] }
          ] } } }
    ]
  }
}
