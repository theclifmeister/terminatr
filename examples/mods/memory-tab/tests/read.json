{
  "name": "enter on a file reads it: headings in the head role, a link as its text, an emoji as ?",
  "answers": [
    { "method": "memory.list", "params": { "slug": "demo" },
      "result": [{ "path": "CONTEXT.md", "title": "Context", "bytes": 80 }] },
    { "method": "memory.read", "params": { "slug": "demo", "path": "CONTEXT.md" },
      "result": "# Context\n\nSee [the plan](docs/plan.md).\n\n## Where things stand\n\nShipping 🚀 soon.\n" }
  ],
  "events": [
    { "name": "view.opened", "project": "demo",
      "data": { "view": "memory", "slot": "project.tab", "project": "demo", "width": 70, "height": 20 } },
    { "name": "ui.key", "project": "demo",
      "data": { "view": "memory", "widget": "files", "row": "CONTEXT.md", "key": "enter", "target": { "project": "demo" } } }
  ],
  "expect": {
    "calls": [
      { "method": "ui.view.set", "params": { "view": "memory" } },
      { "method": "memory.read", "params": { "slug": "demo", "path": "CONTEXT.md" } },
      { "method": "ui.view.set",
        "params": { "view": "memory", "options": { "project": "demo" },
          "widget": { "kind": "stack", "children": [
            { "kind": "text", "lines": [[{ "text": "Context", "role": "accent" }, { "text": "  CONTEXT.md", "role": "faint" }]] },
            { "kind": "text", "text": "See the plan." },
            { "kind": "text", "text": "Where things stand", "role": "head" },
            { "kind": "text", "text": "Shipping ? soon." },
            { "kind": "keys", "keys": [{ "key": "enter", "label": "files" }, { "key": "n", "label": "next" }, { "key": "p", "label": "previous" }] }
          ] } } }
    ]
  }
}
