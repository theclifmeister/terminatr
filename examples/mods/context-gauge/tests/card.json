{
  "name": "the card lists the sessions past the warning, fullest first, each row bound to session.clear and session.attach",
  "settings": { "warn": 70 },
  "store": { "sessions": {
    "s-7": { "project": "demo", "thread": "t-0012", "role": "thread", "context": 74 },
    "s-2": { "project": "demo", "thread": "", "role": "coordinator", "context": 96 },
    "s-4": { "project": "demo", "thread": "t-0013", "role": "thread", "context": 20 },
